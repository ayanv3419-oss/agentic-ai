# Backend
backend/.env
backend/**/__pycache__/
backend/.venv/
backend/venv/
*.pyc

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Root
node_modules/

# Data files (never commit real user data)
data/
*.db
# Ignore JSON data/cache files but NOT config files (vercel.json, package.json etc.)
data/*.json
_dbg_test_cache.json

# Environment files
.env
.env.local
.env.production

# Debug / test artifacts
_dbg_test*
_dbg_test_cache*
*.version

# Editor / OS
.DS_Store
*.log
Thumbs.db

# --- Local scratch & agent working files (never part of the project) -------
# Throwaway dev logs, probes, one-off scripts, and planning notes that pile up
# at the repo root during development. The real source lives under backend/ and
# frontend/. These patterns are anchored to the root ("/") so they never hide a
# legitimately tracked file deeper in the tree.
/_*.err
/_*.out
/_*.sse
/_*.json
/_*.py
/_*.md
/_*.txt
_dev_pids.txt
_audit_*.log
