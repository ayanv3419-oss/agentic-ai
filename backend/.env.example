# Copy to backend/.env and fill in.

# --- Groq -------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Cost / safety budgets -------------------------------------------
MAX_LOOP_ITERATIONS=8
COST_LIMIT_USD=1.0
SQL_MAX_BYTES_SCANNED=10737418240   # 10 GB

# --- Storage paths (absolute, optional — defaults resolve to repo root)
# FINANCIAL_DB_PATH=
# RESPONSE_STORE_PATH=
# SYNONYMS_PATH=

# --- Upload limits ---------------------------------------------------
MAX_UPLOAD_BYTES=1073741824          # 1 GB
UPLOAD_CHUNK_BYTES=1048576           # 1 MB

# --- Server ----------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RELOAD=false

# --- CORS ------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Use * for local dev. In production, set to your Vercel URL:
# ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=*

# --- Session ---------------------------------------------------------
SESSION_SECRET=dev-session-secret-CHANGE-ME

# --- Admin login (REQUIRED when AUTH_ENABLED=true) ------------------
# Master switch. When false (default), every backend route is public —
# matches the historical single-user-MVP behaviour. Flip to true on
# Render once the four fields below are set in the Render dashboard.
AUTH_ENABLED=false
# Credentials checked by POST /auth/login. Username is case-insensitive,
# password is exact. Leaving these empty falls back to the legacy
# APP_LOGIN_USER / APP_LOGIN_PASSWORD pair so existing dev workflows
# keep working without env edits.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Used to sign bearer tokens (HMAC-SHA256). Change to invalidate every
# existing token in one shot — panic-button for credential leaks.
AUTH_TOKEN_SECRET=dev-auth-secret-CHANGE-ME
# Token lifetime in hours (default 168 = 7 days)
AUTH_TOKEN_TTL_HOURS=168
