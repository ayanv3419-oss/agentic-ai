# Copy to backend/.env and fill in.

# --- Groq -------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Cost / safety budgets -------------------------------------------
MAX_LOOP_ITERATIONS=8
COST_LIMIT_USD=1.0
SQL_MAX_BYTES_SCANNED=10737418240   # 10 GB

# --- Storage paths (absolute, optional — defaults resolve to repo root)
# FINANCIAL_DB_PATH=
# RESPONSE_STORE_PATH=
# SYNONYMS_PATH=

# --- Upload limits ---------------------------------------------------
MAX_UPLOAD_BYTES=1073741824          # 1 GB
UPLOAD_CHUNK_BYTES=1048576           # 1 MB

# --- Server ----------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RELOAD=false

# --- CORS ------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Use * for local dev. In production, set to your Vercel URL:
# ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=*

# --- Session ---------------------------------------------------------
SESSION_SECRET=dev-session-secret-CHANGE-ME

# --- Admin login (REQUIRED — empty values disable login) -------------
# These are the credentials that grant access to the entire app.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Used to sign bearer tokens. Change to invalidate every existing token.
AUTH_TOKEN_SECRET=dev-auth-secret-CHANGE-ME
# Token lifetime in hours (default 168 = 7 days)
AUTH_TOKEN_TTL_HOURS=168
